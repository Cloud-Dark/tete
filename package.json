{
  "name": "tete",
  "version": "2.0.0",
  "description": "TETE - Transient Endpoint for Transfer & Encryption. Temporary file sharing on Cloudflare Workers (R2 + D1).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply tete --local",
    "migrate:remote": "wrangler d1 migrations apply tete --remote",
    "deploy": "wrangler deploy",
    "test:smoke": "node test/smoke.mjs"
  },
  "keywords": ["file-sharing", "upload", "cloudflare-workers", "r2", "d1"],
  "license": "ISC",
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
